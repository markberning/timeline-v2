    { "term": "Cotton", "matchText": "cotton", "type": "concept", "definition": "The crop that gave Atlantic slavery a violent second life. Hard to clean by hand, short-staple cotton was barely worth growing until the cotton gin of 1793 removed the bottleneck — after which it spread across the American South and made enslaved labor more, not less, profitable." },
    { "term": "Triangular trade", "matchText": "triangular trade", "type": "concept", "wikiSlug": "Triangular_trade" },
    { "term": "Cotton gin", "matchText": "cotton gin", "type": "concept", "wikiSlug": "Cotton_gin" },
