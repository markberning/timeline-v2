  "4": [
    { "term": "Slave ship", "matchText": "slave ship", "type": "concept", "wikiSlug": "Slave_ship" },
    { "term": "Dysentery", "matchText": "Dysentery", "type": "concept", "definition": "A severe intestinal infection causing bloody diarrhea, called the \"bloody flux\" aboard the ships. In the packed, filthy holds of the Middle Passage it spread easily and was one of the leading killers of the crossing." },
    { "term": "Speculum oris", "matchText": "speculum oris", "type": "concept", "definition": "A mechanical device carried on slave ships to force open the jaws of captives who tried to starve themselves to death by refusing food — one of the purpose-built tools of the trade, later displayed by abolitionists as evidence of its cruelty." },
    { "term": "Zong massacre", "matchText": "Zong", "type": "event", "wikiSlug": "Zong_massacre" },
    { "term": "The scramble", "matchText": "scramble", "type": "concept", "definition": "A method of sale in which a fixed price was set in advance and, at a signal, waiting buyers rushed in a mob into the pen to grab and claim as many captives as they could lay hands on — remembered by survivors as one of the trade's distinct horrors." },
    { "term": "Seasoning", "matchText": "seasoning", "type": "concept", "wikiSlug": "Seasoning_(slavery)" }
  ],
