    { "term": "Apprenticeship", "matchText": "apprenticeship", "type": "concept", "definition": "The system that bound most formerly enslaved people in the British Empire to several more years of unpaid labor for their old masters after the 1833 abolition — a halfway bondage, widely resented, that was cut short only after further protest." },
    { "term": "Frederick Douglass", "matchText": "Frederick Douglass", "type": "person", "wikiSlug": "Frederick_Douglass" },
