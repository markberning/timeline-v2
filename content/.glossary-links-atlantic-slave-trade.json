    { "term": "Slave codes", "matchText": "slave codes", "type": "concept", "wikiSlug": "Slave_codes" },
    { "term": "Domestic slave trade", "matchText": "domestic slave trade", "type": "concept", "definition": "The enormous internal traffic that, over the first half of the nineteenth century, forcibly moved roughly a million enslaved people from the Upper South to the cotton frontier of the Deep South, often marched overland in coffles. Historians call it the \"Second Middle Passage.\"" },
    { "term": "Coffle", "matchText": "coffles", "type": "concept", "definition": "A long line of enslaved people chained together and driven on foot for hundreds of miles, the characteristic form of the domestic slave trade as it carried people from the Upper South to the cotton frontier." }
  ],
  "6": [
    { "term": "Marronage", "matchText": "marronage", "type": "concept", "definition": "The building of free communities by people who had escaped slavery. Wherever the land allowed — dense forest, high mountain, trackless swamp — the escaped gathered, built villages, raised families, and defended themselves, sometimes for generations, against the armies sent to destroy them." },
