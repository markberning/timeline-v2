    {
      "matchText": "Dokyo Affair",
      "term": "Dokyo Affair",
      "definition": "The 769–770 succession crisis (Chapter 7) in which the monk Dokyo, a favorite of the retired Empress Shotoku, allegedly maneuvered to become emperor himself before the court blocked him — the scandal that convinced later rulers the great Buddhist temples had grown too close to the throne."
    },
    {
      "matchText": "Tang-modeled",
      "term": "Tang-modeled",
      "definition": "Built on the template of Tang-dynasty China — the Asuka-Nara court's deliberate copying of Chinese imperial bureaucracy, law codes, and the grid-planned capital, adapted to Japanese conditions."
    },
    {
      "matchText": "Horyu-ji",
      "term": "Horyu-ji",
      "definition": "A Buddhist temple complex near Nara founded in the early 600s, traditionally credited to Prince Shotoku; its oldest halls are among the world's oldest surviving wooden buildings and it remains a working temple today."
    },
    {
      "matchText": "Kofuku-ji",
      "term": "Kofuku-ji",
      "definition": "The Fujiwara clan's family temple at Nara, established as the family's power grew in the eighth century; one of the great Nara temples still in operation."
    },
    {
      "matchText": "Yakushi-ji",
      "term": "Yakushi-ji",
      "definition": "A major Nara-period temple dedicated to the Buddha of Healing (Yakushi), originally vowed by an emperor for an empress's recovery and later moved to the new capital; still active today."
    },
    {
      "matchText": "Toshodai-ji",
      "term": "Toshodai-ji",
      "definition": "The Nara temple founded by the blind Chinese monk Ganjin, who crossed to Japan after repeated failed voyages to bring proper Buddhist ordination; one of the great Nara temples that survives to the present."
    },
    {
      "matchText": "Manyoshu",
      "term": "Manyoshu",
      "definition": "The 'Collection of Ten Thousand Leaves,' the oldest and largest surviving anthology of Japanese poetry, compiled in the eighth century — the foundational text of the native Japanese poetic tradition that every later anthology measured itself against."
    },
