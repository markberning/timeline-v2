    {
      "matchText": "Yugao",
      "term": "Yugao",
      "definition": "A character in The Tale of Genji — the shy, sweet, low-born woman with whom the young Prince Genji has a brief, doomed affair in the novel's fourth chapter, which is named after her. The name means \"evening face,\" a moonflower that opens at dusk."
    },
    {
      "matchText": "Akashi",
      "term": "Akashi",
      "definition": "In The Tale of Genji, both a coastal place where the exiled Genji takes refuge and the proud provincial \"Akashi lady\" he meets there, whose daughter eventually rises to become empress. The thirteenth chapter is named after the place."
    },
    {
      "matchText": "Fujitsubo",
      "term": "Fujitsubo",
      "definition": "A central character in The Tale of Genji — an imperial consort, resembling Genji's dead mother, with whom the young Genji has a forbidden affair that produces a son later passed off as the emperor's legitimate heir. One of pre-modern fiction's most psychologically detailed women."
    },
    {
      "matchText": "Lady Rokujo",
      "term": "Lady Rokujo",
      "definition": "A high-born older lover of Genji in The Tale of Genji, whose consuming jealousy is depicted leaving her body as a vengeful living spirit that harms her rivals — the novel's most famous use of the supernatural to externalize emotion."
    },
    {
      "matchText": "Macedonian-period Constantinople",
      "term": "Macedonian-period Constantinople",
      "definition": "The Byzantine capital during the rule of the Macedonian dynasty (867–1056), a high point of Byzantine power, wealth, and learning — the political and cultural setting in which the princess-historian Anna Komnene would later write."
    },
    {
      "matchText": "Hokke",
      "term": "Hokke",
      "definition": "The senior Northern branch (Hokke) of the Fujiwara clan — the line that monopolized the regency (sesshō and kampaku) and dominated Heian court politics."
    }
  ],
