    },
    {
      "term": "Hekhal",
      "matchText": "Hekhal",
      "definition": "The main hall of Solomon's Temple, the large central room between the entrance porch and the inner sanctuary. It held the golden lampstand, the table of showbread, and the incense altar.",
      "type": "concept"
    },
    {
      "term": "Devir",
      "matchText": "Devir",
      "definition": "The innermost chamber of Solomon's Temple, also called the Holy of Holies — a windowless cube where the Ark of the Covenant rested beneath two gold-covered cherubim. Only the high priest could enter it, once a year.",
      "type": "concept"
