    },
    {
      "term": "Bruce Williams",
      "matchText": "Bruce Williams",
      "definition": "American archaeologist at the University of Chicago's Oriental Institute who directed the Nubian rescue work at Qustul. In a 1979 paper he argued that the Cemetery L tombs were the burials of A-Group kings whose royal iconography — White Crown, serekh — predated the first confirmed Egyptian pharaohs, implying Egyptian kingship itself had Nubian roots. The claim remains a minority position but reshaped the debate.",
      "type": "people"
    },
    {
      "term": "Yam",
      "matchText": "Yam",
      "definition": "The Egyptian name for a distant land far up the Nile, beyond Wawat — most likely the region around the Third Cataract that would later become the core of the Kerma kingdom. Yam was where Old Kingdom Egyptian expeditions went for ebony, ivory, incense, leopard skins, and live exotic animals. Its exact location is still argued about.",
      "type": "place"
    }
